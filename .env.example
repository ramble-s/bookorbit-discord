# Read-only role created by sql/grant-readonly.sql. The host is the database
# container name, so the watcher has to share a network with it.
DATABASE_URL=postgresql://bookorbit_watch:CHANGE_ME@bookorbit-db:5432/bookorbit

DISCORD_WEBHOOK=https://discord.com/api/webhooks/CHANGE/ME
# Optional: makes each card link to <PUBLIC_URL>/requests.
PUBLIC_URL=https://bookorbit.example.com

# Which statuses get a ping. The image default adds `approved`, needed only
# when auto-grab is off (see README). The rest of the pipeline (searching, grabbed,
# downloading, importing) is progress nobody has to act on.
STATUSES=pending,needs_review,failed,available

WEBHOOK_USERNAME=BookOrbit
STATE_FILE=/state/last_seen
HEARTBEAT_FILE=/state/heartbeat
TRIGGER_CHECK_INTERVAL=86400
LOG_LEVEL=INFO
